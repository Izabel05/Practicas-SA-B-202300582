  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Proporcion de solicitudes del gateway sin HTTP 5xx; objetivo 99.5%.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percentunit",
          "noValue": "Sin trafico / sin datos"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(library_http_requests_total{service=\"api-gateway\",status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(library_http_requests_total{service=\"api-gateway\"}[5m])), 0.001)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Disponibilidad - ultima hora",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Percentil 95 de solicitudes al gateway; objetivo menor a 0.75 s.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "s",
          "noValue": "Sin trafico / sin datos"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(library_http_request_duration_seconds_bucket{service=\"api-gateway\"}[5m])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Latencia p95",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Fraccion del presupuesto de error de disponibilidad consumida en la ventana movil de cinco minutos.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percentunit",
          "noValue": "Sin trafico / sin datos"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(library_http_requests_total{service=\"api-gateway\",status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(library_http_requests_total{service=\"api-gateway\"}[5m])), 0.001) / 0.005",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Presupuesto disponibilidad consumido",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Solo gateway: es el unico servicio que emite el bucket de 750 ms en esta version.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percentunit",
          "noValue": "Sin trafico / sin datos"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - sum(rate(library_http_request_duration_seconds_bucket{service=\"api-gateway\",le=\"0.75\"}[5m])) / clamp_min(sum(rate(library_http_request_duration_seconds_count{service=\"api-gateway\"}[5m])), 0.001)) / 0.05",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Presupuesto latencia gateway consumido",
      "type": "stat"
