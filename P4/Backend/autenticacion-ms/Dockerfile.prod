FROM golang:1.23-alpine AS dependencies

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

FROM dependencies AS build

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/autenticacion-ms ./cmd/api

FROM alpine:3.24 AS production

RUN apk upgrade --no-cache \
    && addgroup -S app \
    && adduser -S app -G app
COPY --from=build /out/autenticacion-ms /usr/local/bin/autenticacion-ms

USER app
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/autenticacion-ms"]
