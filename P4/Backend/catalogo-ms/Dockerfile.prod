FROM golang:1.23-alpine AS dependencies

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

FROM dependencies AS build

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/catalogo-ms ./cmd/api

FROM alpine:3.21 AS production

RUN addgroup -S app && adduser -S app -G app
COPY --from=build /out/catalogo-ms /usr/local/bin/catalogo-ms

USER app
EXPOSE 8082
ENTRYPOINT ["/usr/local/bin/catalogo-ms"]
