FROM nginxinc/nginx-unprivileged:1.31-alpine3.24 AS validation

COPY nginx.conf /etc/nginx/nginx.conf
# El DNS de Kubernetes no existe durante el build. Validar una copia con un
# resolver local conserva la comprobacion sintactica sin alterar la config final.
RUN sed 's/resolver kube-dns\.kube-system\.svc\.cluster\.local/resolver 127.0.0.1/' \
      /etc/nginx/nginx.conf > /tmp/nginx.test.conf \
    && nginx -t -c /tmp/nginx.test.conf

FROM nginxinc/nginx-unprivileged:1.31-alpine3.24 AS production

# Actualizar los paquetes del sistema para no conservar CVE corregidas en la
# imagen base cacheada.
RUN apk upgrade --no-cache

COPY --from=validation /etc/nginx/nginx.conf /etc/nginx/nginx.conf

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
