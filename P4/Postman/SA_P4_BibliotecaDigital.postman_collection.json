            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Usuario registrado\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const data = pm.response.json();\r",
                  "    pm.environment.set(\"jwt_token\", data.token);\r",
                  "    pm.environment.set(\"user_id\", data.usuario.id_usuario);\r",
                  "}"
                ],
